{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendar Pro",
  "version": "0.1.0",
  "identifier": "io.github.declanwade.calendarpro",
  "build": {
    "frontendDist": "../desktop/loading",
    "beforeDevCommand": "npm run build && npm run build:sidecar",
    "beforeBuildCommand": "npm run build && npm run build:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Calendar Pro",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/calendar-server"],
    "resources": {
      "../web/dist/": "web/"
    }
  }
}
